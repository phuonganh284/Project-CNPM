# Database Connection
# Get from: Supabase Dashboard → Settings → Database → Connection string (Transaction pooler)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# JWT Secret (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-long-random-string

# Server Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
